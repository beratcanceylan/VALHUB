{
  "name": "valhub",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:unit && npm run test:mobile",
    "test:unit": "vitest run --project unit",
    "test:mobile": "jest",
    "test:coverage": "vitest run --project unit --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov --coverage.reportsDirectory=coverage/unit && jest --coverage --coverageReporters=lcov --coverageDirectory=coverage/mobile",
    "test:a11y": "jest --testPathPattern a11y",
    "check:fixtures": "node tooling/check-fixture-imports.mjs",
    "check:assets": "node tooling/check-bundled-assets.mjs",
    "check:secrets": "node tooling/check-secrets.mjs",
    "check": "npm run check:fixtures && npm run check:assets && npm run check:secrets",
    "build:mobile": "expo export --platform ios --platform android",
    "doctor": "expo-doctor",
    "ci": "npm run typecheck && npm run lint && npm run check && npm test"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo-doctor": "1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3",
    "react-native-worklets": "0.10.1"
  },
  "main": "expo-router/entry",
  "dependencies": {
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.104.0",
    "@valhub/api-contract": "0.1.0",
    "@valhub/core": "0.1.0",
    "@valhub/design-tokens": "0.1.0",
    "@valhub/domain": "0.1.0",
    "expo": "~57.0.25",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testMatch": [
      "<rootDir>/test/**/*.test.tsx",
      "<rootDir>/test/**/*.test.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@shopify/flash-list|react-native-svg|@valhub/.*)"
    ],
    "setupFiles": [
      "<rootDir>/test/setup.ts"
    ]
  }
}
